# ============================================================
#  Iron360 — Environment configuration (EXAMPLE)
#  Copy to `.env` and fill real values. NEVER commit `.env`.
# ============================================================

# --- App ---
IRON360_ENV=development            # development | production
IRON360_HOST=127.0.0.1
IRON360_PORT=8000

# --- Security ---
# Leave JWT secret blank to auto-generate one on first boot (stored in data/.jwt_secret, gitignored).
IRON360_JWT_SECRET=
IRON360_JWT_TTL_MINUTES=480

# First admin user, seeded ONCE on first boot (password is hashed with PBKDF2, never stored in plaintext).
# After first boot you may rotate it via the UI / API; changing this value afterwards does nothing.
IRON360_ADMIN_USERNAME=admin
IRON360_ADMIN_PASSWORD=change-me-on-first-boot

# Comma-separated hostnames/origins allowed to call the API (CORS). Use your tunnel domain in prod.
IRON360_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# --- AI orchestration (Anthropic) ---
# If unset (and no base URL below), the AI engine runs in SAFE SIMULATION mode (no tokens, demo-only).
ANTHROPIC_API_KEY=
# Optional: route through OmniRoute / a gateway that speaks the Anthropic Messages API (/v1/messages).
# Example (local OmniRoute): http://127.0.0.1:4000   |   (via Cloudflare): https://omniroute.yourdomain.com
ANTHROPIC_BASE_URL=
IRON360_AI_MODEL=claude-opus-4-8
IRON360_AI_EFFORT=high

# --- Executor ---
# Hard ceiling (seconds) for any single security tool invocation.
IRON360_TOOL_TIMEOUT=600
# Global master switch. Set to 'false' to make the executor refuse ALL live tool runs (dry-run only).
IRON360_EXECUTOR_ENABLED=true
